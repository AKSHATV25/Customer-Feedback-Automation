      "parameters": {
        "promptType": "define",
        "text": "=You are an AI that classifies customer feedback.\n\nClassify the following feedback into exactly ONE of these categories:\n\n- Complaint\n- Compliment\n- Feature Addition Request\n\nClassification Rules:\n- Complaint: The customer reports a problem, dissatisfaction, poor experience, bug, or negative feedback.\n- Compliment: The customer only expresses praise, satisfaction, or appreciation without asking for changes.\n- Feature Addition Request: The customer requests a new feature, enhancement, or improvement. Suggestions such as \"need improvement\", \"could be better\", or \"please add\" belong here unless they clearly describe a problem.\n\nCustomer Feedback:\n{{ $json.FEEDBACK }}\n\nRespond with ONLY one of these exact values:\n\nComplaint\nCompliment\nFeature Addition Request",
        "options": {
          "systemMessage": "Your role is to determine if the feedback filled by the customer is a complaint, a compliment or a feature addition request. Respond with exactly one of: Complain, Compliment, or Feature Addition Request."
        }
      },
